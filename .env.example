# Copy to .env.local for development. Set real values in the hosting provider's
# environment settings (Vercel → Project → Settings → Environment Variables).
# Never commit real keys.

# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.mrcghana.com

# EXISTING Lovable registration application. Optional: defaults to
# https://mrcghana2027.lovable.app/register (src/config/event.ts).
# Set to https://register.mrcghana.com/register once the custom domain is live.
NEXT_PUBLIC_REGISTRATION_URL=

# Form delivery (partner + contact enquiries). Configure ONE of the options.
# Option A — Resend (https://resend.com): transactional email API.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="MRC Ghana Website <no-reply@mrcghana.com>"
# Approved organiser mailbox(es) that receive enquiries. Comma-separated.
ENQUIRY_TO_EMAIL=
# Option B — POST JSON to an approved webhook (e.g. Make, Zapier, Formspree).
FORM_WEBHOOK_URL=

# Optional anti-spam: Cloudflare Turnstile (in addition to honeypot + timing checks).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional privacy-friendly analytics (Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
