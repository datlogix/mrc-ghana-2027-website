{
  "name": "mrc-ghana-2027-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Minoan RobotSports Competition Ghana 2027 (MRC Ghana 2027)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pdfs": "tsx scripts/generate-pdfs.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:links": "tsx scripts/check-links.ts",
    "prebuild": "npm run validate:content"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "marked": "18.0.14",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "pdfkit": "0.17.2",
    "postcss": "8.5.30",
    "qrcode": "1.5.4",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
